{
  "name": "gitward",
  "version": "0.1.0",
  "description": "Detect, clean and monitor PolinRider supply-chain malware in repos and on your computer",
  "type": "module",
  "bin": {
    "gitward": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
