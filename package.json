  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gowreesh-VT/gitward.git"
  },
  "keywords": [
    "security",
    "malware",
    "supply-chain",
    "github",
    "polinrider",
    "scanner"
  ],
  "author": "Gowreesh V T"
}
